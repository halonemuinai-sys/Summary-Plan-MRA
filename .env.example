# Copy this file to .env.local and fill in the real values. .env.local is ignored by git.

# PostgreSQL connection. On Supabase, take it from Project Settings > Database > Connection string.
#
# Use a POOLER address, not db.<ref>.supabase.co: the direct host answers on IPv6 only, and most
# networks (and Vercel) reach it over IPv4. The user name carries the project ref.
#
#   local development  -> session pooler,     port 5432
#   Vercel / serverless -> transaction pooler, port 6543  (built for many short-lived connections)
#
# The app names its schema in every query (mra.), so either pooler works.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
